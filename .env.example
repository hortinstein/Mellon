# Copy to .env and fill in. Never commit .env.

# TypeSafe Jev API key. Leave empty to run with the offline mock judge.
TYPESAFE_API_KEY=

# Encrypts stored secrets and identity rules. Generate once and keep it:
#   openssl rand -base64 32
# Changing it later makes existing secrets unreadable.
MELLON_SECRET_KEY=

# Optional
JEV_MODEL=jev-latest
MELLON_PORT=3000
